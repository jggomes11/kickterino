{
  "name": "kickterino",
  "productName": "Kickterino",
  "version": "0.3.0",
  "description": "Cliente multi-chat da Kick (estilo Chatterino) que mant\u00e9m voc\u00ea assistindo v\u00e1rias lives para acumular pontos do canal.",
  "author": "VinniiSaantos",
  "license": "MIT",
  "homepage": "https://github.com/jggomes11/kickterino#readme",
  "repository": "github:jggomes11/kickterino",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "node --test --test-isolation=none tests/*.test.cjs",
    "test:electron": "node scripts/test-electron.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.vinniisaantos.kickterino",
    "productName": "Kickterino",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jggomes11",
        "repo": "kickterino"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "security/**/*"
    ],
    "electronFuses": {
      "enableCookieEncryption": true,
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Kickterino-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kickterino",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Kickterino-portatil.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "executableName": "kickterino",
      "synopsis": "Chat e pontos da Kick para o PokeIdle",
      "maintainer": "VinniiSaantos <122901997+ViinniSantoos@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Kickterino-linux.AppImage"
    },
    "deb": {
      "artifactName": "Kickterino-linux.deb"
    }
  },
  "desktopName": "kickterino.desktop",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
